<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RuvioExamples.Desktop</RootNamespace>
    <AssemblyName>RuvioLoadConsole</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RuvioExamples.LoadKit\RuvioExamples.LoadKit.csproj" />
  </ItemGroup>
</Project>
